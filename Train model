import numpy as np
import pandas as pd
import joblib
from sklearn.compose import ColumnTransformer
from sklearn.ensemble import RandomForestRegressor
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_absolute_error, r2_score

RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)

EDUCATION_LEVELS = ["High School", "Bachelor's", "Master's", "PhD"]
EDUCATION_BONUS = {"High School": 0, "Bachelor's": 120000, "Master's": 220000, "PhD": 350000}

NUMERIC_FEATURES = [
    "years_experience",
    "skill_level",         # self-rated overall technical skill, 1-10
    "communication_score",  # 1-10
    "num_languages",        # programming/spoken languages known
    "num_tech",              # technologies/frameworks known
    "num_tools",             # tools known (Git, Docker, AWS, etc.)
    "num_projects",          # completed projects
]
CATEGORICAL_FEATURES = ["education_level"]
ALL_FEATURES = NUMERIC_FEATURES + CATEGORICAL_FEATURES
TARGET = "salary"


def build_synthetic_dataset(n=4000):
    years_experience = np.round(np.random.exponential(scale=5, size=n).clip(0, 40), 1)
    education_level = np.random.choice(EDUCATION_LEVELS, size=n, p=[0.15, 0.5, 0.28, 0.07])
    skill_level = np.random.randint(1, 11, size=n)
    communication_score = np.random.randint(1, 11, size=n)
    num_languages = np.random.randint(1, 8, size=n)
    num_tech = np.random.randint(1, 15, size=n)
    num_tools = np.random.randint(0, 12, size=n)
    num_projects = np.random.randint(0, 30, size=n)

    base_salary = 300000
    edu_bonus = np.array([EDUCATION_BONUS[e] for e in education_level])

    salary = (
        base_salary
        + years_experience * 42000
        + edu_bonus
        + skill_level * 16000
        + communication_score * 9000
        + num_languages * 11000
        + num_tech * 9500
        + num_tools * 7000
        + num_projects * 6000
        + np.random.normal(0, 60000, size=n)  # noise
    )
    salary = np.clip(salary, 150000, None)

    df = pd.DataFrame({
        "years_experience": years_experience,
        "education_level": education_level,
        "skill_level": skill_level,
        "communication_score": communication_score,
        "num_languages": num_languages,
        "num_tech": num_tech,
        "num_tools": num_tools,
        "num_projects": num_projects,
        "salary": salary,
    })
    return df


def main():
    df = build_synthetic_dataset()
    df.to_csv("synthetic_salary_data.csv", index=False)

    X = df[ALL_FEATURES]
    y = df[TARGET]

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.2, random_state=RANDOM_STATE
    )

    preprocessor = ColumnTransformer(
        transformers=[
            ("cat", OneHotEncoder(categories=[EDUCATION_LEVELS], handle_unknown="ignore"), CATEGORICAL_FEATURES),
        ],
        remainder="passthrough",
    )

    model = Pipeline(steps=[
        ("preprocessor", preprocessor),
        ("regressor", RandomForestRegressor(
            n_estimators=100, max_depth=8, random_state=RANDOM_STATE, n_jobs=-1
        )),
    ])

    model.fit(X_train, y_train)

    preds = model.predict(X_test)
    mae = mean_absolute_error(y_test, preds)
    r2 = r2_score(y_test, preds)
    print(f"MAE: {mae:,.2f}")
    print(f"R2:  {r2:.3f}")

    joblib.dump(model, "salary_model.pkl", compress=3)
    print("Saved salary_model.pkl")


if __name__ == "__main__":
    main()
