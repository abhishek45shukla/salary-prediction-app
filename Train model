```python
import numpy as np
import pandas as pd
import joblib

from sklearn.compose import ColumnTransformer
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)

EDUCATION_LEVELS = ["High School", "Bachelor's", "Master's", "PhD"]

EDUCATION_BONUS = {
    "High School": 0,
    "Bachelor's": 120000,
    "Master's": 220000,
    "PhD": 350000
}

NUMERIC_FEATURES = [
    "years_experience",
    "skill_level",
    "communication_score",
    "num_languages",
    "num_tech",
    "num_tools",
    "num_projects",
]

CATEGORICAL_FEATURES = ["education_level"]

ALL_FEATURES = NUMERIC_FEATURES + CATEGORICAL_FEATURES

TARGET = "salary"


def build_synthetic_dataset(n=4000):

    years_experience = np.round(
        np.random.exponential(scale=5, size=n).clip(0, 40), 1
    )

    education_level = np.random.choice(
        EDUCATION_LEVELS,
        size=n,
        p=[0.15, 0.5, 0.28, 0.07]
    )

    skill_level = np.random.randint(1, 11, size=n)
    communication_score = np.random.randint(1, 11, size=n)
    num_languages = np.random.randint(1, 8, size=n)
    num_tech = np.random.randint(1, 15, size=n)
    num_tools = np.random.randint(0, 12, size=n)
    num_projects = np.random.randint(0, 30, size=n)

    base_salary = 300000

    edu_bonus = np.array([
        EDUCATION_BONUS[e] for e in education_level
    ])

    salary = (
        base_salary
        + years_experience * 42000
        + edu_bonus
        + skill_level * 16000
        + communication_score * 9000
        + num_languages * 11000
        + num_tech * 9500
        + num_tools * 7000
        + num_projects * 6000
        + np.random.normal(0, 60000, size=n)
    )

    salary = np.clip(salary, 150000, None)

    df = pd.DataFrame({
        "years_experience": years_experience,
        "education_level": education_level,
        "skill_level": skill_level,
        "communication_score": communication_score,
        "num_languages": num_languages,
        "num_tech": num_tech,
        "num_tools": num_tools,
        "num_projects": num_projects,
        "salary": salary,
    })

    return df


def main():

    # Create dataset
    df = build_synthetic_dataset()

    # Save dataset
    df.to_csv("synthetic_salary_data.csv", index=False)

    # Features and target
    X = df[ALL_FEATURES]
    y = df[TARGET]

    # Train-test split
    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.2,
        random_state=RANDOM_STATE
    )

    # Preprocessing
    preprocessor = ColumnTransformer(
        transformers=[
            (
                "cat",
                OneHotEncoder(
                    categories=[EDUCATION_LEVELS],
                    handle_unknown="ignore"
                ),
                CATEGORICAL_FEATURES
            ),
        ],
        remainder="passthrough",
    )

    # Linear Regression pipeline
    model = Pipeline(
        steps=[
            ("preprocessor", preprocessor),
            ("regressor", LinearRegression()),
        ]
    )

    # Train model
    model.fit(X_train, y_train)

    # Predictions
    preds = model.predict(X_test)

    # Evaluation
    mae = mean_absolute_error(y_test, preds)
    mse = mean_squared_error(y_test, preds)
    rmse = np.sqrt(mse)
    r2 = r2_score(y_test, preds)

    print(f"MAE:  {mae:,.2f}")
    print(f"MSE:  {mse:,.2f}")
    print(f"RMSE: {rmse:,.2f}")
    print(f"R2:   {r2:.3f}")

    # Save trained model
    joblib.dump(
        model,
        "salary_model.pkl",
        compress=3
    )

    print("Saved salary_model.pkl")


if __name__ == "__main__":
    main()
```

### What changed from your Random Forest version?

Only the model itself:

**Before:**

```python
from sklearn.ensemble import RandomForestRegressor
```

and:

```python
("regressor", RandomForestRegressor(
    n_estimators=100,
    max_depth=8,
    random_state=RANDOM_STATE,
    n_jobs=-1
))
```

**Now:**

```python
from sklearn.linear_model import LinearRegression
```

and:

```python
("regressor", LinearRegression())
```

Everything else—including your preprocessing and train/test pipeline—stays essentially the same.

When you run this version, **don't blindly use the approximate metrics I gave earlier**. Use the numbers printed by your actual run as your final interview metrics.
